# =============================================================================
# EXEMPLO / TEMPLATE - NAO USE ESTES VALORES NO SERVIDOR.
# =============================================================================
# Todos os valores abaixo sao DE EXEMPLO e precisam ser TROCADOS pela
# configuracao real do seu ambiente antes de qualquer uso. Copiar este
# arquivo para a mao e insuficiente: nada aqui vai funcionar sem edicao.
#
# Uso correto:
#   cp .env.example /etc/auth-service/auth.env
#   # editar TODOS os valores marcados como EXEMPLO
#   chmod 600 /etc/auth-service/auth.env
#
# NUNCA versionar o arquivo real: ele contem senha da conta de servico.
# O .env real do servidor fica em /etc/auth-service/auth.env, fora do git.
# =============================================================================

# --- LDAP / Active Directory ------------------------------------------------
# Os 4 valores abaixo sao EXEMPLO e devem ser trocados.
#
# AUTH_LDAP_BASE e a BASE DO DOMINIO, nao um container de usuarios.
# Com CN=Users,..., a busca por sAMAccountName nao acha ninguem e o
# login devolve 401 sem explicar o motivo. Para descobrir a base real:
#   ldbsearch -H ldap://127.0.0.1 -b "" -s base "(objectclass=*)" namingContexts
AUTH_LDAP_URL=ldaps://ldap.exemplo.com:636
AUTH_LDAP_BASE=DC=exemplo,DC=com
AUTH_LDAP_USER_DN=CN=svc-auth,OU=Service Accounts,DC=exemplo,DC=com
AUTH_LDAP_PASSWORD=
AUTH_LDAP_USER_SEARCH_BASE=OU=Usuarios,DC=exemplo,DC=com

# --- PostgreSQL -------------------------------------------------------------
# AUTH_PG_URL e AUTH_PG_SCHEMA sao EXEMPLO; ajuste a URL e o schema reais.
AUTH_PG_URL=jdbc:postgresql://127.0.0.1:5432/brasil-saas
AUTH_PG_SERVICE_USER=
AUTH_PG_SCHEMA=brasil_saas
AUTH_PG_ACCESS_GROUP=

# --- Token ------------------------------------------------------------------
# AUTH_TOKEN_SECRET e OBRIGATORIO e sem valor padrao: gere um segredo novo
# a cada instalacao. Exemplo de como gerar (nao e um segredo real):
#   openssl rand -base64 48
AUTH_TOKEN_SECRET=
